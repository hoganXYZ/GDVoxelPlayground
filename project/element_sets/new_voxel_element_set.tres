[sub_resource type="VoxelElement" id="VoxelElement_r2b7p"]
element_name = "mushroom_stalk"
movement_class = 4
density = 150.0
base_color = Color(0.91775256, 0.9058309, 0.83228356, 1)
heat_conduct = 0.1
temp_high = 598.0
state_high = "fire"
reactions = [ExtResource("2_skay2"), ExtResource("3_6t1iu")]
custom_glsl = "void ca_tick(ivec3 pos, uint voxel_index, Voxel voxel, uint aux) {
    uint energy = voxel.data & 0x1Fu;
    if (energy == 0u) return; // passive stem
    uint palette = (voxel.data >> 5) & 0x7u;
    if (cellRoll10k(pos, 78u) >= 2500u) return; // ~25% growth per tick

    ivec3 up = pos + ivec3(0, 1, 0);
    if (!isValidPos(up)) return;
    uint up_index = posToIndex(up);
    if (!isVoxelAir(getPreviousVoxel(up_index))) {
        Voxel stunted = voxel;
        stunted.data &= ~0x1Fu; // blocked: stop growing forever
        setVoxel(voxel_index, stunted);
        return;
    }

    uint child_elem = (energy > 1u) ? CA_SELF : 22u; // last step spawns the gill core
    Voxel child = createElementVoxel(child_elem, up);
    if (energy > 1u)
        child.data |= (palette << 5) | ((energy - 1u) & 0x1Fu);
    else
        child.data |= (palette << 5) | 3u; // gill spread budget = cap radius

    if (casVoxelCurrent(up_index, 0u, child.data) == 0u) {
        setAux(up_index, defaultAuxFor(child_elem));
        Voxel stem = voxel;
        stem.data &= ~0x1Fu;
        setVoxel(voxel_index, stem);
    }
}"

[sub_resource type="VoxelElement" id="VoxelElement_q47xt"]
element_name = "mushroom_gill"
movement_class = 4
heat_conduct = 0.1
temp_high = 598.0
state_high = "fire"
reactions = [ExtResource("2_skay2"), ExtResource("3_6t1iu")]
custom_glsl = "const ivec3 gill_dirs[4] = ivec3[](
    ivec3(1, 0, 0), ivec3(-1, 0, 0), ivec3(0, 0, 1), ivec3(0, 0, -1)
);

// sandboxels' mushroom_cap color list
const vec3 gill_cap_palette[8] = vec3[](
    vec3(0.78, 0.38, 0.26), vec3(0.78, 0.27, 0.26), vec3(0.78, 0.26, 0.49),
    vec3(0.75, 0.26, 0.78), vec3(0.49, 0.26, 0.78), vec3(0.27, 0.26, 0.78),
    vec3(0.26, 0.41, 0.78), vec3(0.26, 0.78, 0.78)
);

void ca_tick(ivec3 pos, uint voxel_index, Voxel voxel, uint aux) {
    uint budget  = voxel.data & 0x1Fu;
    uint palette = (voxel.data >> 5) & 0x7u;

    // cap above, 10% per tick
    ivec3 up = pos + ivec3(0, 1, 0);
    if (isValidPos(up) && cellRoll10k(pos, 90u) < 1000u) {
        uint up_index = posToIndex(up);
        if (isVoxelAir(getPreviousVoxel(up_index))) {
            Voxel cap = createVoxel(23u, randomizedColor(gill_cap_palette[palette], up));
            if (casVoxelCurrent(up_index, 0u, cap.data) == 0u)
                setAux(up_index, defaultAuxFor(23u));
        }
    }

    // spread the gill disk sideways while budget remains, 2% per side per tick
    if (budget == 0u) return;
    for (int i = 0; i < 4; i++) {
        if (cellRoll10k(pos, 91u + uint(i)) >= 200u) continue;
        ivec3 n = pos + gill_dirs[i];
        if (!isValidPos(n)) continue;
        uint n_index = posToIndex(n);
        if (!isVoxelAir(getPreviousVoxel(n_index))) continue;
        Voxel g = createElementVoxel(CA_SELF, n);
        g.data |= (palette << 5) | ((budget - 1u) & 0x1Fu);
        if (casVoxelCurrent(n_index, 0u, g.data) == 0u)
            setAux(n_index, defaultAuxFor(CA_SELF));
    }
}
"

